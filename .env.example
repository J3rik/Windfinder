# Windfinder alert service - SMTP configuration template.
#
# Copy to .env and fill in your own mail account:
#
#     cp .env.example .env
#
# alert_service.py loads .env automatically at start-up. Real environment
# variables take precedence, so exporting the same names in your shell (or via
# docker-compose.yml) also works and is the preferred way in production.
#
# NEVER commit .env - it holds a password. It is listed in .gitignore.

# --- Server ----------------------------------------------------------------
# Your provider's outgoing mail server. Examples:
#   smtp.gmail.com          port 587 (needs an app password)
#   smtp-mail.outlook.com   port 587
#   mail.example.com        port 587
SMTP_SERVER=

# 587 = STARTTLS (typical). Use 465 with SMTP_STARTTLS=0 for implicit TLS.
SMTP_PORT=587

# --- Authentication (required) ---------------------------------------------
# The service authenticates on every send, so both values must be set.
# Most providers require an app-specific password here, not your account
# password. For Gmail: https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASSWORD=

# --- Sender ----------------------------------------------------------------
# Address shown in the From header. Defaults to SMTP_USER when empty.
SMTP_SENDER=

# --- Optional --------------------------------------------------------------
# 1 = STARTTLS on port 587; set to 0 for implicit TLS on port 465.
SMTP_STARTTLS=1

# Ports tried in order when the configured port cannot be reached (temporary
# firewall or provider block). Leave empty to disable the fallback.
SMTP_FALLBACK_PORTS=25,465
